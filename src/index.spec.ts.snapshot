`;

exports[`SequelizePage > supports filtering 4`] = `
"Executing (default): SELECT \\"User\\".* FROM (SELECT \\"first_name\\" AS \\"firstName\\", \\"last_name\\" AS \\"lastName\\", \\"id\\" FROM \\"Users\\" AS \\"User\\" WHERE \\"User\\".\\"birth_date\\" >= '1990-01-01' AND (\\"User\\".\\"first_name\\" < 'Bernard' OR (\\"User\\".\\"first_name\\" = 'Bernard' AND (\\"User\\".\\"last_name\\" < 'LastName' OR (\\"User\\".\\"last_name\\" = 'LastName' AND \\"User\\".\\"id\\" < 4)))) ORDER BY \\"User\\".\\"first_name\\" DESC, \\"User\\".\\"last_name\\" DESC, \\"User\\".\\"id\\" DESC LIMIT 1) AS \\"User\\" ORDER BY \\"firstName\\" DESC, \\"lastName\\" DESC, \\"User\\".\\"id\\" DESC;"
`;

