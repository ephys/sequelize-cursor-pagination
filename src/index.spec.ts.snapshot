exports[`SequelizePage > supports filtering 1`] = `
"Executing (default): SELECT \\"User\\".* FROM (SELECT \\"first_name\\" AS \\"firstName\\", \\"last_name\\" AS \\"lastName\\", \\"id\\" FROM \\"Users\\" AS \\"User\\" WHERE \\"User\\".\\"birth_date\\" >= '1990-01-01' AND (\\"User\\".\\"first_name\\" > 'Bernard' OR (\\"User\\".\\"first_name\\" = 'Bernard' AND (\\"User\\".\\"last_name\\" > 'LastName' OR (\\"User\\".\\"last_name\\" = 'LastName' AND \\"User\\".\\"id\\" > 4)))) ORDER BY \\"User\\".\\"first_name\\" ASC, \\"User\\".\\"last_name\\" ASC, \\"User\\".\\"id\\" ASC LIMIT 11) AS \\"User\\" ORDER BY \\"firstName\\" ASC, \\"lastName\\" ASC, \\"User\\".\\"id\\" ASC;"
`;

